# PAWSAFE — regras da pasta pública (Apache / XAMPP).

# Não listar o conteúdo das pastas.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se o pedido for um arquivo ou pasta que existe (CSS, JS, imagem,
    # página .html), o Apache serve direto, sem passar pelo PHP.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Qualquer outro pedido (as rotas /api/*) vai para o front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Página inicial da pasta: o dashboard.
DirectoryIndex index.html
