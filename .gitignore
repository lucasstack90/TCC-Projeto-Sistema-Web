# Logs e uploads gerados em tempo de execução (não versionar o conteúdo).
storage/logs/*
!storage/logs/.gitkeep
storage/uploads/animais/*
!storage/uploads/animais/.gitkeep

# Configuração local com senha real (opcional): se um dia você criar um
# config.local.php com a senha do banco, ele não deve ir para o repositório.
config/config.local.php

# Lixo de sistema operacional / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
