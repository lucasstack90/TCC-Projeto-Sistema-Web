APP_NAME=PAWSAFE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Pelo Apache do XAMPP (pasta C:\xampp\htdocs\Sistema-web): http://localhost/Sistema-web
# Com "php artisan serve": http://127.0.0.1:8000
APP_URL=http://localhost/Sistema-web
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL do XAMPP (painel do XAMPP → MySQL → Start).
# O usuário padrão do XAMPP é "root" sem senha. Crie o banco "pawsafe" no phpMyAdmin
# com o agrupamento utf8mb4_unicode_ci antes de rodar "php artisan migrate".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pawsafe
DB_USERNAME=root
DB_PASSWORD=

# Sessão em arquivos (storage/framework/sessions): não precisa de tabela extra.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Bcrypt com custo 12 para as senhas (hash, nunca texto puro).
BCRYPT_ROUNDS=12

MAIL_MAILER=log
